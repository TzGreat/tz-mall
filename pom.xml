<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    Maven POM 文件头部声明
    - xmlns: XML 命名空间，定义 POM 的结构规范
    - xsi:schemaLocation: 指定 POM 结构定义文件的位置
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- POM 模型版本，固定为 4.0.0 -->
	<modelVersion>4.0.0</modelVersion>

	<!-- 
	    父 POM 继承配置
	    - 继承 Spring Boot 的父 POM，获得 Spring Boot 的自动配置能力
	    - Spring Boot 3.2.5 要求 JDK 17+
	    - relativePath 为空表示从 Maven 仓库查找
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.1.10</version>
		<relativePath/>
	</parent>

	<!-- 
	    项目坐标（GAV）
	    - groupId: 组织/公司标识，通常是域名倒写
	    - artifactId: 项目/模块名称
	    - version: 项目版本，SNAPSHOT 表示开发中版本
	    - packaging: 打包类型，pom 表示聚合模块（不产生 jar/war）
	-->
	<groupId>com.tzmall</groupId>
	<artifactId>tz-mall</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>tz-mall</name>
	<description>TZ-Mall 微服务商城项目</description>
	<packaging>pom</packaging>

	<!-- 
	属性定义区域
	- 用于统一管理版本号和配置参数
	- 使用 ${属性名} 在其他地方引用
	-->
	<properties>
		<!-- JDK 版本配置 -->
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Spring Cloud 版本（2022.0.5 对应 Spring Boot 3.1.x） -->
		<spring-cloud.version>2022.0.5</spring-cloud.version>
		<!-- Spring Cloud Alibaba 版本 -->
		<spring-cloud-alibaba.version>2023.0.1.2</spring-cloud-alibaba.version>
		<!-- MyBatis-Plus 版本（boot3 适配 Spring Boot 3.x） -->
		<mybatis-plus.version>3.5.5</mybatis-plus.version>
		<!-- Knife4j API 文档工具版本 -->
		<knife4j.version>4.5.0</knife4j.version>
		<!-- Hutool 工具库版本 -->
		<hutool.version>5.8.28</hutool.version>
		<!-- MySQL 驱动版本（8.0.31+ groupId 为 com.mysql） -->
		<mysql.version>8.0.32</mysql.version>
		<!-- Seata 分布式事务版本 -->
		<seata.version>2.1.0</seata.version>
	</properties>

	<!-- 
	子模块列表
	- 声明当前聚合模块包含的所有子模块
	- Maven 会按顺序构建这些模块
	- 路径为相对于当前 pom.xml 的相对路径
	-->
	<modules>
		<!-- 公共模块 -->
		<module>tz-mall-common/common-core</module>
		<module>tz-mall-common/common-redis</module>
		<module>tz-mall-common/common-mq</module>
		<module>tz-mall-common/common-es</module>
		<module>tz-mall-common/common-swagger</module>
		<!-- API 接口模块 -->
		<module>tz-mall-api/api-user</module>
		<module>tz-mall-api/api-item</module>
		<module>tz-mall-api/api-order</module>
		<!-- 网关模块 -->
		<module>tz-mall-gateway</module>
		<!-- 业务服务聚合模块 -->
		<module>tz-mall-services</module>
	</modules>

	<!-- 
	依赖版本管理（dependencyManagement）
	- 仅声明依赖版本，不会自动引入
	- 子模块声明依赖时可省略版本号
	- 实现版本统一管理，避免版本冲突
	-->
	<dependencyManagement>
		<dependencies>
			<!-- 
			    Spring Cloud 依赖管理
			    - type=pom, scope=import: 导入 Spring Cloud 的依赖版本管理
			-->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Spring Cloud Alibaba 依赖管理 -->
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-alibaba-dependencies</artifactId>
				<version>${spring-cloud-alibaba.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- 
			    MyBatis-Plus 依赖
			    - mybatis-plus-spring-boot3-starter: 适配 Spring Boot 3.x
			    - boot3 表示使用 jakarta 命名空间（替代 javax）
			-->
			<dependency>
				<groupId>com.baomidou</groupId>
				<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
				<version>${mybatis-plus.version}</version>
			</dependency>

			<!-- Knife4j API 文档工具 -->
			<dependency>
				<groupId>com.github.xiaoymin</groupId>
				<artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
				<version>${knife4j.version}</version>
			</dependency>

			<!-- 
			    MySQL 驱动
			    - 注意：MySQL Connector/J 8.0.31+ 的 groupId 已从 mysql 改为 com.mysql
			    - 用于 Java 应用连接 MySQL 数据库
			-->
			<dependency>
				<groupId>com.mysql</groupId>
				<artifactId>mysql-connector-j</artifactId>
				<version>${mysql.version}</version>
			</dependency>

			<!-- Hutool 工具库 -->
			<dependency>
				<groupId>cn.hutool</groupId>
				<artifactId>hutool-all</artifactId>
				<version>${hutool.version}</version>
			</dependency>

			<!-- Seata 分布式事务 -->
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-starter-alibaba-seata</artifactId>
				<version>${spring-cloud-alibaba.version}</version>
			</dependency>

			<!-- 
			项目内部模块依赖声明
			- 声明本项目各模块的版本
			- 子模块之间依赖时可省略版本号
		-->
			<dependency>
				<groupId>com.tzmall</groupId>
				<artifactId>common-core</artifactId>
				<version>1.0.0-SNAPSHOT</version>
			</dependency>

			<dependency>
				<groupId>com.tzmall</groupId>
				<artifactId>common-redis</artifactId>
				<version>1.0.0-SNAPSHOT</version>
			</dependency>

			<dependency>
				<groupId>com.tzmall</groupId>
				<artifactId>common-mq</artifactId>
				<version>1.0.0-SNAPSHOT</version>
			</dependency>

			<dependency>
				<groupId>com.tzmall</groupId>
				<artifactId>common-es</artifactId>
				<version>1.0.0-SNAPSHOT</version>
			</dependency>

			<dependency>
				<groupId>com.tzmall</groupId>
				<artifactId>common-swagger</artifactId>
				<version>1.0.0-SNAPSHOT</version>
			</dependency>

			<dependency>
				<groupId>com.tzmall</groupId>
				<artifactId>api-user</artifactId>
				<version>1.0.0-SNAPSHOT</version>
			</dependency>

			<dependency>
				<groupId>com.tzmall</groupId>
				<artifactId>api-item</artifactId>
				<version>1.0.0-SNAPSHOT</version>
			</dependency>

			<dependency>
				<groupId>com.tzmall</groupId>
				<artifactId>api-order</artifactId>
				<version>1.0.0-SNAPSHOT</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- 
	构建配置
	- 配置 Maven 构建时使用的插件
	-->
	<build>
		<plugins>
			<!-- 
			    Spring Boot Maven 插件
			    - 用于打包 Spring Boot 应用为可执行 jar
			    - 配置 excludes 排除 lombok（因为 lombok 是编译时注解处理器）
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
